diff -ruN Hurrican/src/hur_probe.cpp Hurrican/src/hur_probe.cpp
--- Hurrican/src/hur_probe.cpp	1969-12-31 16:00:00.000000000 -0800
+++ Hurrican/src/hur_probe.cpp	2026-10-10 10:28:47.741381015 -0700
@@ -0,0 +1,128 @@
+#include "hur_probe.hpp"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cmath>
+#include <vector>
+#include <chrono>
+#include "DX8Graphics.hpp"
+#include "Globals.hpp"
+#include "Main.hpp"
+
+int hur_tag = 9;
+int hur_frame = 0;
+static FILE *out = nullptr;
+static const int NTAG = 12, NBLEND = 3, NTEX = 2;
+// per frame: area (pixels at 640x480, clipped), draw calls, triangles, alpha area (vertex alpha<255)
+static double area[NTAG][NBLEND][NTEX], aarea[NTAG][NBLEND][NTEX];
+static long calls[NTAG][NBLEND][NTEX], tris[NTAG][NBLEND][NTEX];
+
+static FILE *get() {
+  if (!out) { const char *p = getenv("HUR_PROBE"); out = fopen(p ? p : "hur_probe.txt", "w"); }
+  return out;
+}
+
+struct P { double x, y; };
+static int clip_edge(const P *in, int n, P *o, int edge) {
+  // 0: x>=0 1: x<=640 2: y>=0 3: y<=480
+  int m = 0;
+  for (int i = 0; i < n; i++) {
+    P a = in[i], b = in[(i + 1) % n];
+    auto inside = [&](P p) { switch (edge) { case 0: return p.x >= 0; case 1: return p.x <= 640; case 2: return p.y >= 0; default: return p.y <= 480; } };
+    auto isect = [&](P p, P q) { double t; P r; switch (edge) {
+      case 0: t = (0 - p.x) / (q.x - p.x); r = {0, p.y + t * (q.y - p.y)}; break;
+      case 1: t = (640 - p.x) / (q.x - p.x); r = {640, p.y + t * (q.y - p.y)}; break;
+      case 2: t = (0 - p.y) / (q.y - p.y); r = {p.x + t * (q.x - p.x), 0}; break;
+      default: t = (480 - p.y) / (q.y - p.y); r = {p.x + t * (q.x - p.x), 480}; } return r; };
+    bool ia = inside(a), ib = inside(b);
+    if (ia) o[m++] = a;
+    if (ia != ib) o[m++] = isect(a, b);
+  }
+  return m;
+}
+static double tri_area(P a, P b, P c) {
+  P in[3] = {a, b, c}, t1[9], t2[12];
+  int n = clip_edge(in, 3, t1, 0); if (!n) return 0;
+  n = clip_edge(t1, n, t2, 1); if (!n) return 0;
+  n = clip_edge(t2, n, t1, 2); if (!n) return 0;
+  n = clip_edge(t1, n, t2, 3); if (!n) return 0;
+  double s = 0;
+  for (int i = 0; i < n; i++) { P p = t2[i], q = t2[(i + 1) % n]; s += p.x * q.y - q.x * p.y; }
+  return std::fabs(s) * 0.5;
+}
+
+void hur_probe_draw(unsigned prim, unsigned count, const void *verts, int blend, int textured) {
+  const VERTEX2D *v = static_cast<const VERTEX2D *>(verts);
+  int tg = hur_tag < 0 || hur_tag >= NTAG ? NTAG - 1 : hur_tag;
+  int bl = blend < 0 || blend >= NBLEND ? 0 : blend;
+  int tx = textured ? 1 : 0;
+  calls[tg][bl][tx]++;
+  unsigned ntri = 0;
+  auto add = [&](const VERTEX2D &a, const VERTEX2D &b, const VERTEX2D &c) {
+    double ar = tri_area({a.x, a.y}, {b.x, b.y}, {c.x, c.y});
+    area[tg][bl][tx] += ar; ntri++;
+    unsigned al = reinterpret_cast<const unsigned char *>(&a.color)[3];
+    if (al < 255) aarea[tg][bl][tx] += ar;
+  };
+  if (prim == 0x0004 /*GL_TRIANGLES*/) { for (unsigned i = 0; i < count; i++) add(v[3*i], v[3*i+1], v[3*i+2]); }
+  else if (prim == 0x0005 /*GL_TRIANGLE_STRIP*/) { for (unsigned i = 0; i < count; i++) add(v[i], v[i+1], v[i+2]); }
+  tris[tg][bl][tx] += ntri;
+}
+
+void hur_probe_frame(void) {
+  FILE *f = get(); if (!f) return;
+  for (int t = 0; t < NTAG; t++) for (int b = 0; b < NBLEND; b++) for (int x = 0; x < NTEX; x++) {
+    if (!calls[t][b][x]) continue;
+    fprintf(f, "F %d %d %d %d %ld %ld %.0f %.0f\n", hur_frame, t, b, x, calls[t][b][x], tris[t][b][x], area[t][b][x], aarea[t][b][x]);
+    calls[t][b][x] = tris[t][b][x] = 0; area[t][b][x] = aarea[t][b][x] = 0;
+  }
+  hur_frame++;
+  const char *n = getenv("HUR_FRAMES");
+  if (n && hur_frame >= atoi(n)) { fflush(f); GameRunning = false; }
+}
+void hur_probe_tex(const char *name, int xs, int ys, int xfc, int yfc, int xfs, int yfs) {
+  FILE *f = get(); if (f) { fprintf(f, "T %s %d %d %d %d %d %d\n", name, xs, ys, xfc, yfc, xfs, yfs); fflush(f); }
+}
+void hur_probe_level(int stage, const char *name, int sx, int sy, int nobj) {
+  FILE *f = get(); if (f) { fprintf(f, "L %d %s %d %d %d frame=%d\n", stage, name, sx, sy, nobj, hur_frame); fflush(f); }
+}
+void hur_probe_note(const char *s, float a, float b) {
+  FILE *f = get(); if (f) fprintf(f, "N %d %s %.1f %.1f\n", hur_frame, s, a, b);
+}
+
+// ---- scripted player: hold a direction, jump and fire in bursts, turn round when stuck
+bool hur_script_active(void) { static int v = -1; if (v < 0) v = getenv("HUR_SCRIPT") ? 1 : 0; return v == 1; }
+void hur_script_input(bool *akt, float xpos, float ypos, int nakt) {
+  static int dir = 1, f = 0, stuck = 0; static float lx = -1, ly = -1;
+  f++;
+  if (f % 60 == 0) hur_probe_note("pos", xpos, ypos);
+  if (f % 120 == 0) { if (std::fabs(xpos - lx) < 24 && std::fabs(ypos - ly) < 24) { stuck++; dir = -dir; } else stuck = 0; lx = xpos; ly = ypos; }
+  for (int i = 0; i < nakt; i++) akt[i] = false;
+  akt[dir > 0 ? 1 : 0] = true;                // AKTION_RECHTS / LINKS
+  if ((f % 75) < 22) akt[5] = true;           // JUMP
+  if ((f % 40) < 25) akt[6] = true;           // SHOOT
+  if ((f % 300) < 20) akt[9] = true;          // GRANATE now and then
+  if (stuck >= 3 && (f % 60) < 30) akt[3] = true;   // OBEN (climb / doors)
+}
+
+bool hur_sweep_next(float *x, float *y) {
+  static std::vector<std::pair<float,float>> pts; static int loaded = 0, f = 0; static size_t k = 0;
+  if (!loaded) { loaded = 1; const char *p = getenv("HUR_SWEEP"); if (p) { FILE *s = fopen(p, "r"); float a, b; if (s) { while (fscanf(s, "%f %f", &a, &b) == 2) pts.push_back({a, b}); fclose(s); } } }
+  if (pts.empty()) return false;
+  f++;
+  int per = getenv("HUR_SWEEP_FRAMES") ? atoi(getenv("HUR_SWEEP_FRAMES")) : 90;
+  if (f % per != 1) return false;
+  if (k >= pts.size()) { FILE *o = get(); if (o) { fprintf(o, "N %d sweepdone 0 0\n", hur_frame); fflush(o); } GameRunning = false; return false; }
+  *x = pts[k].first; *y = pts[k].second; k++;
+  hur_probe_note("spot", *x, *y);
+  return true;
+}
+void hur_probe_logic(int chunks, double us, int ng, int np, int npart) {
+  FILE *f = get(); if (f) fprintf(f, "G %d %d %.0f %d %d %d\n", hur_frame, chunks, us, ng, np, npart);
+}
+static std::chrono::steady_clock::time_point t0;
+void hur_probe_time(int phase) {
+  auto now = std::chrono::steady_clock::now();
+  if (phase) { FILE *f = get(); if (f) fprintf(f, "R %d %.0f\n", hur_frame, std::chrono::duration<double, std::micro>(now - t0).count()); }
+  t0 = now;
+}
