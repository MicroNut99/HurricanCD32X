+// Feasibility probe: counts what the renderer draws per frame.
+#pragma once
+#include <cstdint>
+extern int hur_tag;                 // which phase of the frame is drawing (see Gameplay.cpp)
+extern int hur_frame;
+void hur_probe_draw(unsigned prim, unsigned count, const void *verts, int blend, int textured);
+void hur_probe_frame(void);
+void hur_probe_tex(const char *name, int xs, int ys, int xfc, int yfc, int xfs, int yfs);
+void hur_probe_level(int stage, const char *name, int sx, int sy, int nobj);
+void hur_probe_note(const char *s, float a, float b);
+bool hur_script_active(void);
+bool hur_sweep_next(float *x, float *y);
+void hur_probe_logic(int chunks, double us_logic, int ng, int np, int npart);
+void hur_probe_time(int phase);
+void hur_script_input(bool *aktion, float xpos, float ypos, int nakt);
